# Hostidian configuration. Copy to `.env` (or run `scripts/gen-env.sh`, which fills in random secrets).

# ---- Public address -------------------------------------------------------
# Caddy site address. `localhost` => self-signed HTTPS for local testing.
# Set to your real domain (e.g. notes.example.com) for automatic Let's Encrypt HTTPS.
# HTTPS is REQUIRED for the PWA (service worker / install) on anything other than localhost.
DOMAIN=localhost
# Externally visible base URL (no trailing slash). Used for cookies (Secure flag), Origin checks, invite/share links, OIDC redirect.
PUBLIC_URL=https://localhost
# Extra allowed browser Origins, comma separated (dev: http://localhost:3000)
ALLOWED_ORIGINS=
HTTP_PORT=80
HTTPS_PORT=443

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=hostidian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hostidian
# Used by api and collab. In compose the host is `postgres`.
DATABASE_URL=postgres://hostidian:change-me@postgres:5432/hostidian?sslmode=disable

# ---- Secrets (generate with: openssl rand -base64 48) -----------------------
# Signs the short-lived collab JWTs (api -> browser -> collab)
COLLAB_JWT_SECRET=change-me
# Bearer token for service-to-service calls (api <-> collab)
INTERNAL_TOKEN=change-me
# Signs OIDC state/nonce cookies
APP_SECRET=change-me

# ---- Go API -------------------------------------------------------------------
API_ADDR=:8080
INTERNAL_ADDR=:8081
COLLAB_INTERNAL_URL=http://collab:1235
# Browser-facing WebSocket URL returned by /pages/{id}/collab-token. Default: derived from PUBLIC_URL (wss://<host>/collab)
COLLAB_PUBLIC_URL=
DATA_DIR=/data
MAX_UPLOAD_MB=50
# Max size of a Markdown/Obsidian-vault zip accepted by the importer (Caddy allows 512 MB on /api/*)
MAX_IMPORT_MB=500
LOG_LEVEL=info

# ---- Collab service ---------------------------------------------------------------
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1235
API_INTERNAL_URL=http://api:8081

# ---- OIDC (optional; enabled only when issuer + client id + secret are all set) -----
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label on the login page
OIDC_NAME=Single sign-on
# Redirect URI to register at the provider: ${PUBLIC_URL}/api/auth/oidc/callback
